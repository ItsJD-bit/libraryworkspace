<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Libspace patron view and barcode scanning desk" />
    <title>Patron View | Libspace</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/styles.css" />
    <script src="/js/page-transition.js" defer></script>
    <script src="/js/patron-view.js" defer></script>
    <script src="/js/account-menu.js" defer></script>
  </head>
  <body class="page-enter">

    <main class="patron-view-page full-viewport">
      <section class="patron-view-header full-width-header">
        <div>
          <div class="eyebrow" id="patron-greeting-eyebrow">Good morning / Welcome to the library</div>
          <h1 id="patron-greeting-title">Good <span id="patron-greeting-text">morning</span>, <span>patron.</span></h1>
          <p>Quickly scan a library barcode to confirm the patron record at the service desk.</p>
        </div>
      </section>

      <section class="patron-view-panel">
        <div class="patron-scan-card">
          <div class="scan-header">
            <span class="step-label">Scan barcode</span>
            <h2>Patron access desk</h2>
          </div>

          <form id="patron-scan-form" class="patron-scan-form">
            <label class="field barcode-field">
              <span>Barcode</span>
              <input id="patron-scan-input" name="barcode" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Scan or enter barcode" required />
            </label>
            <button type="submit" class="primary-button"><span>Lookup patron</span><span class="button-arrow" aria-hidden="true">→</span></button>
          </form>

          <div id="scan-message" class="form-message" role="status" hidden></div>
        </div>

        <aside class="patron-focus-card">
          <span class="step-label">Current patron</span>
          <div class="focus-name" id="focus-name">Waiting for scan</div>
          <div class="focus-meta" id="focus-department">No patron loaded</div>
          <div class="focus-meta small" id="focus-barcode">Barcode: --</div>
        </aside>
      </section>
    </main>

    <!-- Patron Service Selection Modal -->
<div
  id="service-modal"
  class="modal hidden"
  aria-hidden="true"
>
  <div
    class="modal-backdrop"
    data-close-service-modal
    aria-hidden="true"
  ></div>

  <section
    class="modal-card patron-modal-card service-modal-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="service-modal-title"
  >
    <header class="modal-header">

      <div>
        <span class="step-label">
          Library services
        </span>

        <h3 id="service-modal-title">
          How can we assist you?
        </h3>

        <p class="service-modal-subtitle">
          Welcome,
          <strong id="service-patron-name">
            patron
          </strong>.
        </p>
      </div>

      <button
        type="button"
        class="modal-close"
        data-close-service-modal
        aria-label="Close service selection"
      >
        &times;
      </button>

    </header>

    <div class="service-grid">

      <button
        type="button"
        class="service-card"
        data-service="printing"
      >
        <span class="service-icon">P</span>

        <span class="service-content">
          <strong>Printing Services</strong>
          <small>
            Print documents and other library materials.
          </small>
        </span>

        <span class="service-arrow">→</span>
      </button>


      <button
        type="button"
        class="service-card"
        data-service="internet"
      >
        <span class="service-icon">I</span>

        <span class="service-content">
          <strong>Internet Room</strong>
          <small>
            Use an available library computer.
          </small>
        </span>

        <span class="service-arrow">→</span>
      </button>


      <button
        type="button"
        class="service-card"
        data-service="circulation"
      >
        <span class="service-icon">C</span>

        <span class="service-content">
          <strong>Library Circulation</strong>
          <small>
            Borrow, return, or renew library materials.
          </small>
        </span>

        <span class="service-arrow">→</span>
      </button>


      <button
        type="button"
        class="service-card"
        data-service="research"
      >
        <span class="service-icon">R</span>

        <span class="service-content">
          <strong>Undergraduate Research</strong>
          <small>
            Research assistance and library resources.
          </small>
        </span>

        <span class="service-arrow">→</span>
      </button>


      <button
        type="button"
        class="service-card"
        data-service="periodicals"
      >
        <span class="service-icon">P</span>

        <span class="service-content">
          <strong>Periodicals Reading Area</strong>
          <small>
            Access journals, newspapers, and periodicals.
          </small>
        </span>

        <span class="service-arrow">→</span>
      </button>


      <button
        type="button"
        class="service-card"
        data-service="discussion"
      >
        <span class="service-icon">D</span>

        <span class="service-content">
          <strong>Discussion Room</strong>
          <small>
            Reserve or join a discussion room.
          </small>
        </span>

        <span class="service-arrow">→</span>
      </button>


      <button
        type="button"
        class="service-card service-card-wide"
        data-service="consultation"
      >
        <span class="service-icon">L</span>

        <span class="service-content">
          <strong>Librarian's Consultation</strong>
          <small>
            Speak with a librarian for personalized assistance.
          </small>
        </span>

        <span class="service-arrow">→</span>
      </button>

    </div>

    <div class="service-modal-footer">
      <span class="note-icon">i</span>
      <span>Select a service to continue.</span>
    </div>

  </section>
</div>


    <footer><span>LIBSPACE by Eden</span><span>PATRON SERVICE · QUICK LOOKUP</span></footer>
  </body>
</html>
