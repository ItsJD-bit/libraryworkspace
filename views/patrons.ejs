<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Library patron workspace" />
    <title>Patrons | Libspace</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/styles.css" />
    <script src="/js/page-transition.js" defer></script>
    <script src="/js/patrons.js" defer></script>
    <script src="/js/account-menu.js" defer></script>
  </head>
  <body class="page-enter">
    <header class="topbar">
      <a class="brand" href="/" aria-label="Libspace home"><span class="brand-mark" aria-hidden="true">L</span><span>Lib<em>space</em></span></a>
      <div class="account-menu"><div class="status-pill" tabindex="0" aria-label="Account menu"><span class="status-dot"></span><span><%= locals.account?.name || 'Library Workspace' %></span><span class="caret">▾</span></div><div class="account-dropdown" aria-label="Account options"><button type="button" class="dropdown-item">Account</button><button type="button" class="dropdown-item">Admin</button><button type="button" class="dropdown-item danger">Logout</button></div></div>
    </header>

    <main class="patrons-page">
      <section class="patrons-heading">
        <div><div class="eyebrow">Library operations / 02</div><h1>Patron <span>records.</span></h1><p>Keep student access details clear, searchable, and ready at the service desk.</p></div>
        <a class="back-link" href="/">← Dashboard</a>
      </section>
      <section class="patron-table-panel" aria-labelledby="patron-table-title">
        <div class="table-toolbar"><div><span class="step-label">Directory</span><h2 id="patron-table-title">students</h2></div><label class="search-field"><span>Search records</span><input id="patron-search" type="search" placeholder="Name, barcode, or student_id" /></label></div>
        <div class="table-scroll"><table><thead><tr><th>id</th><th>barcode</th><th>first_name</th><th>last_name</th><th>course</th><th>year</th><th>patron_type</th><th>department</th><th>student_id</th></tr></thead><tbody id="patron-rows"><tr class="empty-row"><td colspan="9">No patron records in this workspace.</td></tr></tbody></table></div>
        <div class="table-footer"><span id="record-count">0 records</span><span>Columns mirror the planned students table</span></div>
      </section>
    </main>
    <footer><span>LIBSPACE by Eden</span><span>PATRON SERVICE · PRIVATE WORKSPACE</span></footer>
  </body>
</html>
