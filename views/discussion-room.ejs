<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Library discussion room workspace" />
    <title>Discussion Room | Libspace</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/styles.css" />
    <script src="/js/page-transition.js" defer></script>
    <script src="/js/discussion-room.js" defer></script>
    <script src="/js/account-menu.js" defer></script>
  </head>
  <body class="page-enter">
    <header class="topbar">
      <a class="brand" href="/" aria-label="Libspace home"><span class="brand-mark" aria-hidden="true">L</span><span>Lib<em>space</em></span></a>
      <div class="account-menu"><div class="status-pill" tabindex="0" aria-label="Account menu"><span class="status-dot"></span><span><%= locals.account?.name || 'Library Workspace' %></span><span class="caret">▾</span></div><div class="account-dropdown" aria-label="Account options"><button type="button" class="dropdown-item">Account</button><button type="button" class="dropdown-item">Admin</button><button type="button" class="dropdown-item danger">Logout</button></div></div>
    </header>

    <main class="internet-page">
      <section class="internet-heading">
        <div><div class="eyebrow">Library operations / 03</div><h1>Discussion <span>room.</span></h1><p>Reserve a quiet room for group study, meetings, and collaborative sessions with quick patron check-in.</p></div>
        <a class="back-link" href="/">← Dashboard</a>
      </section>

      <section class="room-overview" aria-label="Discussion room status">
        <div class="overview-number"><strong id="available-count">0</strong><span>Available rooms</span></div>
        <div class="overview-number"><strong id="reservation-count">0</strong><span>Reservations</span></div>
        <div class="overview-number"><strong id="in-use-count">0</strong><span>In use</span></div>
        <div class="overview-note"><span class="status-dot"></span><span>Room open<br /><small>Bookings are coordinated in this workspace</small></span></div>
      </section>

      <section class="room-actions discussion-actions" aria-labelledby="session-title">
        <div class="session-intro"><span class="step-label">Reservation desk</span><h2 id="session-title">Build a group</h2><p>Scan the request master's barcode first, then scan each member. A group needs 3–8 patrons.</p><div class="capacity-rule">Minimum 3 · Maximum 8 patrons</div><div id="group-summary" class="group-summary">No patrons scanned yet.</div></div>
        <div>
          <form id="session-form" class="session-form">
            <label class="field barcode-field"><span>Patron barcode</span><input id="barcode-input" name="barcode" autocomplete="off" placeholder="Scan or type barcode" required /></label>
            <button class="secondary-button" type="submit"><span>Add scanned patron</span><span class="button-arrow" aria-hidden="true">+</span></button>
          </form>
          <div id="session-message" class="form-message" role="status" hidden></div>
          <div id="lobby-list" class="lobby-list"><span class="lobby-empty">Scanned patrons appear in the lobby list.</span></div>
          <form id="reservation-form" class="reservation-form">
            <label class="field"><span>Room</span><select id="room-select" name="room" required><option value="Room 1">Room 1</option><option value="Room 2">Room 2</option></select></label>
            <label class="field"><span>Date</span><input id="date-input" name="date" type="date" required /></label>
            <label class="field"><span>Start time</span><input name="startTime" type="time" required /></label>
            <label class="field"><span>Time needed</span><select name="duration" required><option value="30">30 minutes</option><option value="60">1 hour</option><option value="90">1 hour 30 minutes</option><option value="120">2 hours</option><option value="180">3 hours</option></select></label>
            <button class="primary-button" type="submit"><span>Reserve room</span><span class="button-arrow" aria-hidden="true">→</span></button>
          </form>
        </div>
      </section>

   

      <section class="session-table-panel" aria-labelledby="active-title">
        <div class="table-toolbar"><div><span class="step-label">Live directory</span><h2 id="active-title">Current room users</h2></div><span id="session-count" class="tool-count">0 active sessions</span></div>
        <div class="table-scroll"><table><thead><tr><th>Request master</th><th>Department</th><th>Room</th><th>Date</th><th>Time in</th><th>Elapsed time</th><th>Action</th></tr></thead><tbody id="session-rows"><tr class="empty-row"><td colspan="7">No rooms are currently in session.</td></tr></tbody></table></div>
      </section>
    </main>

    <div id="reservation-modal" class="modal hidden" aria-hidden="true">
      <div class="modal-backdrop" data-close-modal="true"></div>
      <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="reservation-modal-title">
        <div class="modal-header">
          <div>
            <span class="step-label">Reservation details</span>
            <h3 id="reservation-modal-title">Room reservation</h3>
          </div>
          <button type="button" class="modal-close" data-close-modal="true" aria-label="Close reservation details">×</button>
        </div>
        <div id="reservation-modal-body" class="modal-body"></div>
      </div>
    </div>
    <footer><span>LIBSPACE by Eden</span><span>DISCUSSION ROOM · RESERVATION DESK</span></footer>
  </body>
</html>
